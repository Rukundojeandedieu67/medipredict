# API configuration. These variables use the MEDIPREDICT_ prefix.
MEDIPREDICT_APP_NAME=MediPredict Rwanda
MEDIPREDICT_DATABASE_URL=sqlite:///./backend/medipredict.db
# Optional comma-separated origins for browser clients hosted on other domains.
MEDIPREDICT_CORS_ORIGINS=
MEDIPREDICT_MODEL_PATH=ml_engine/models_store/medipredict_rf_model.pkl
MEDIPREDICT_METRICS_PATH=ml_engine/models_store/medipredict_metrics.json
MEDIPREDICT_CSV_PATH=datasets/medipredict_data/processed/medipredict_facility_timeseries_2026.csv


# API configuration. These variables use the MEDIPREDICT_ prefix.
MEDIPREDICT_APP_NAME=MediPredict Rwanda
MEDIPREDICT_DATABASE_URL=sqlite:///./backend/medipredict.db
MEDIPREDICT_DATABASE_ENABLED=true
# Set to false for the CSV-only local dashboard; database-backed features return 503.
# Aiven PostgreSQL connection. Copy to backend/.env, uncomment, and replace the password.
# URL-encode special characters in the password. Never commit the populated connection URL.
MEDIPREDICT_DATABASE_URL=postgresql://avnadmin:REPLACE_WITH_URL_ENCODED_PASSWORD@pg-1119047b-rukundojeandedieu670-6e4d.i.aivencloud.com:23893/defaultdb?sslmode=require
# Optional comma-separated origins for browser clients hosted on other domains.
MEDIPREDICT_CORS_ORIGINS=
MEDIPREDICT_STORAGE_BACKEND=local
# Cloudflare R2 uses the S3-compatible API. Keep access keys out of Git and browser config.
# Set the backend to s3 only after all R2 values and the dashboard CSV object are configured.
# MEDIPREDICT_STORAGE_BACKEND=s3
MEDIPREDICT_OBJECT_STORE_BUCKET=
# Cloudflare R2 S3 API endpoint; replace ACCOUNT_ID with your Cloudflare account ID.
MEDIPREDICT_OBJECT_STORE_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIPREDICT_OBJECT_STORE_REGION=auto
MEDIPREDICT_OBJECT_STORE_ACCESS_KEY_ID=
MEDIPREDICT_OBJECT_STORE_SECRET_ACCESS_KEY=
# When using R2, set this to the object key of the dashboard CSV in the bucket.
MEDIPREDICT_DASHBOARD_DATA_KEY=
MEDIPREDICT_MODEL_PATH=ml_engine/models_store/medipredict_rf_model.pkl
MEDIPREDICT_METRICS_PATH=ml_engine/models_store/medipredict_metrics.json
MEDIPREDICT_CSV_PATH=datasets/medipredict_data/processed/medipredict_facility_timeseries_2026.csv
MEDIPREDICT_ADMIN_API_KEY=

# Docker Compose settings. Set MODEL_VERSION only to a reviewed, validated model version.
API_PORT=8000
FRONTEND_PORT=8080
MODEL_VERSION=unpromoted
FEATURE_DATASET_ID=
FEATURE_BUILD_ID=

# Optional external stock-warning delivery. Never enable against synthetic data.
# Keep credentials in an untracked .env file or secret manager.
MEDIPREDICT_ALERT_SMTP_HOST=
MEDIPREDICT_ALERT_SMTP_PORT=587
MEDIPREDICT_ALERT_SMTP_STARTTLS=true
MEDIPREDICT_ALERT_SMTP_USERNAME=
MEDIPREDICT_ALERT_SMTP_PASSWORD=
MEDIPREDICT_ALERT_EMAIL_FROM=
MEDIPREDICT_ALERT_EMAIL_TO=
MEDIPREDICT_ALERT_TWILIO_ACCOUNT_SID=
MEDIPREDICT_ALERT_TWILIO_AUTH_TOKEN=
MEDIPREDICT_ALERT_TWILIO_FROM=
MEDIPREDICT_ALERT_SMS_TO=
MEDIPREDICT_ALERT_COOLDOWN_HOURS=24
